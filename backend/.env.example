# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/pharmacy-finder

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Google OAuth (Backend token verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Service Configuration (for password reset emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM=PharmacyFinder <noreply@pharmacyfinder.com>

# Optional Routing Engine (OSRM)
# OSRM_URL=http://localhost:5001/route/v1/driving
